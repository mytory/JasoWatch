<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>assets\icons\jasowatch-active.ico</ApplicationIcon>
    <AssemblyName>Mytory Jaso Watch</AssemblyName>
    <Product>Mytory Jaso Watch</Product>
    <Title>Mytory Jaso Watch</Title>
    <Description>Mac에서 온 분해형 파일명을 Windows에서 NFC로 정리하는 포터블 유틸리티</Description>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="JasoWatch.Tests\**\*.cs" />
    <EmbeddedResource Include="assets\icons\*.ico" />
  </ItemGroup>
</Project>
